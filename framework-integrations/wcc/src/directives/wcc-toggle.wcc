<script>
import { defineComponent, defineProps } from 'wcc'

export default defineComponent({
  tag: 'wcc-toggle',
})

const props = defineProps({ show: true })
</script>

<template>
<div class="toggle">
  <p show="props.show">This content is toggled via show directive</p>
</div>
</template>

<style>
.toggle {
  padding: 8px 12px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin: 8px 0;
}
.toggle p {
  margin: 0;
}
</style>
