<script>
import { defineComponent, defineProps } from 'wcc'

export default defineComponent({
  tag: 'wcc-conditional',
})

const props = defineProps({ visible: true })
</script>

<template>
<div class="conditional">
  <p if="props.visible">Visible</p>
  <p else>Hidden</p>
</div>
</template>

<style>
.conditional {
  padding: 8px 12px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin: 8px 0;
}
.conditional p {
  margin: 0;
  font-weight: bold;
}
</style>
