{
  "name": "wcc-framework-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "use:local": "yarn add -D wccompiler@portal:../.. && echo 'Using local version'",
    "use:npm": "yarn add -D @sprlab/wccompiler && echo 'Using npm version'",
    "build:vue": "wcc build --config wcc.config.vue.js",
    "build:react": "wcc build --config wcc.config.react.js",
    "build:angular": "wcc build --config wcc.config.angular.js",
    "build": "npm run build:vue && npm run build:react && npm run build:angular"
  },
  "devDependencies": {
    "wccompiler": "portal:../.."
  }
}
