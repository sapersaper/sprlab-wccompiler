<script>
import { defineComponent, signal, computed } from 'wcc'

export default defineComponent({
  tag: 'test-signals',
})

// Crear signals
const count = signal(0)
const message = signal('Hola WCC')

// Computed derivado de signal
const doubled = computed(() => count() * 2)

// Funciones para modificar signals
function increment() {
  count.set(count() + 1)
}

function decrement() {
  count.set(count() - 1)
}

function reset() {
  count.set(0)
}

function updateMessage() {
  message.set('Mensaje actualizado!')
}
</script>

<template>
  <div class="signals-test">
    <h3>Test de Signals</h3>
    
    <div class="counter-section">
      <p>Count: {{count()}}</p>
      <p>Doubled (computed): {{doubled()}}</p>
      <div class="buttons">
        <button @click="decrement">-1</button>
        <button @click="reset">Reset</button>
        <button @click="increment">+1</button>
      </div>
    </div>

    <div class="message-section">
      <p>Message: {{message()}}</p>
      <button @click="updateMessage">Actualizar Mensaje</button>
    </div>
  </div>
</template>

<style>
.signals-test {
  border: 1px solid #9c27b0;
  padding: 15px;
  border-radius: 8px;
  background-color: #f3e5f5;
}
.signals-test h3 {
  color: #6a1b9a;
  margin-top: 0;
}
.counter-section, .message-section {
  margin: 15px 0;
  padding: 10px;
  background: white;
  border-radius: 4px;
}
.buttons {
  display: flex;
  gap: 5px;
  margin-top: 10px;
}
button {
  padding: 8px 16px;
  background-color: #9c27b0;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
button:hover {
  background-color: #7b1fa2;
}
</style>
