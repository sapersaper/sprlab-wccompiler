<script>
import { defineComponent, signal } from 'wcc'

export default defineComponent({
  tag: 'test-no-batch',
})

const count = signal(0)

function increment() {
  count.set(count() + 1)
}
</script>

<template>
  <div class="no-batch-test">
    <h3>🌳 Test 5: Tree-Shaking - No Batch Usage</h3>
    
    <div class="description">
      <p>Este componente NO usa <code>batch()</code>, por lo que el código generado debería ser más pequeño (tree-shaking).</p>
    </div>

    <button @click="increment">{{count()}}</button>
    
    <div class="expected">
      <h5>Expected:</h5>
      <ul>
        <li>✅ Generated code does NOT include function __batch(fn)</li>
        <li>✅ Smaller bundle size</li>
        <li>✅ Component works correctly</li>
      </ul>
    </div>
  </div>
</template>

