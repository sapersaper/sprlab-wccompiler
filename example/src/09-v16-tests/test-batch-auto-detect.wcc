<script>
import { defineComponent, signal, watch, batch } from 'wcc'

export default defineComponent({
  tag: 'test-batch-auto-detect',
})

const firstName = signal('')
const lastName = signal('')
const age = signal(0)
const effectRunCount = signal(0)

// Watch expression que lee los signals para suscribirse (reemplaza effect())
watch(() => firstName() + lastName() + age(), () => {
  effectRunCount.set(effectRunCount() + 1)
})

function updateWithoutBatch() {
  // Reset counter
  effectRunCount.set(0)
  
  // 3 updates separados → 3 effect executions
  firstName.set('John')
  lastName.set('Doe')
  age.set(30)
}

function updateWithBatch() {
  // Reset counter
  effectRunCount.set(0)
  
  // 3 updates en batch → 1 effect execution
  batch(() => {
    firstName.set('Jane')
    lastName.set('Smith')
    age.set(25)
  })
}

function reset() {
  firstName.set('')
  lastName.set('')
  age.set(0)
  effectRunCount.set(0)
}
</script>

<template>
  <div class="batch-test">
    <h3>⚡ Test v0.16.0: Auto-Detection of batch()</h3>
    
    <div class="description">
      <p><strong>Feature:</strong> El compilador ahora detecta automáticamente cuando usas <code>batch()</code> y lo transforma correctamente.</p>
      <p><strong>Beneficio:</strong> 66% menos ejecuciones de effects cuando actualizas múltiples signals.</p>
    </div>

    <div class="controls">
      <button @click="updateWithoutBatch">Sin Batch (3 signals)</button>
      <button @click="updateWithBatch">Con Batch (3 signals)</button>
      <button @click="reset">Reset</button>
    </div>

    <div class="results">
      <div class="result-item">
        <h4>Effect Execution Counter</h4>
        <p class="counter">{{effectRunCount()}}</p>
        <p class="explanation">
          Sin Batch: debería ser <strong>3</strong><br>
          Con Batch: debería ser <strong>1</strong>
        </p>
      </div>

      <div class="result-item">
        <h4>Signal Values</h4>
        <p><strong>firstName:</strong> {{firstName()}}</p>
        <p><strong>lastName:</strong> {{lastName()}}</p>
        <p><strong>age:</strong> {{age()}}</p>
      </div>
    </div>

    <div class="expected">
      <h5>Expected Results:</h5>
      <ul>
        <li>✅ Component compiles without errors</li>
        <li>✅ No "ReferenceError: batch is not defined"</li>
        <li>✅ "Sin Batch" button → Counter = 3</li>
        <li>✅ "Con Batch" button → Counter = 1</li>
        <li>✅ Performance improvement: 66% fewer effect executions</li>
      </ul>
    </div>
  </div>
</template>

