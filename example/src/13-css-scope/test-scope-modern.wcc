<script>
import { defineComponent } from 'wcc'

export default defineComponent({
  tag: 'test-scope-modern',
})
</script>

<template>
  <div class="modern-test">
    <h3>Modern CSS Features in @scope</h3>
    <div class="container">
      <p>:is() and :where() selectors</p>
      <div class="box">
        <span class="highlight">Highlighted</span>
        <span>Normal</span>
      </div>
    </div>
  </div>
</template>

<style>
.modern-test {
  border: 2px solid #607d8b;
  padding: 16px;
  border-radius: 8px;
}

/* :is() — should NOT split by internal comma */
:is(h1, h2, h3, h4) {
  font-family: monospace;
  border-bottom: 1px solid #ccc;
}

/* :where() — should NOT split by internal comma */
:where(.box, .container) {
  padding: 8px;
  margin: 8px 0;
}

/* Comma-separated selectors — should EACH be scoped */
.box, .highlight {
  display: inline-block;
}

.highlight {
  background-color: #ffeb3b;
  padding: 2px 6px;
  border-radius: 4px;
}
</style>
