<script>
import { defineComponent, signal } from 'wcc'

export default defineComponent({
  tag: 'test-no-collision',
})

const greeting = signal('Hello')

// Función con nombre DIFERENTE al signal - debería funcionar
function getGreeting() {
  return 'Hi from function'
}

function updateGreeting() {
  greeting.set('Updated Hello')
}
</script>

<template>
  <div class="test-container">
    <h3>✅ Test 1: Parameterless Functions WITHOUT Collision</h3>
    
    <div class="test-case">
      <h4>Test Case 1: Signal + Function with Different Names</h4>
      
      <div class="result">
        <p><strong>Signal value:</strong> {{greeting()}}</p>
        <p><strong>Function call:</strong> {{getGreeting()}}</p>
      </div>

      <button @click="updateGreeting">Update Signal</button>
      
      <div class="expected">
        <h5>Expected Results:</h5>
        <ul>
          <li>✅ Component compiles without errors</li>
          <li>✅ Signal value displays: "Hello"</li>
          <li>✅ Function call displays: "Hi from function"</li>
          <li>✅ Both values update correctly when signal changes</li>
          <li>✅ No console errors</li>
        </ul>
      </div>
    </div>
  </div>
</template>

