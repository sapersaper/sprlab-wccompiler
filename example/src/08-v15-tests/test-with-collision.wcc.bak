<script>
import { defineComponent, signal } from 'wcc'

export default defineComponent({
  tag: 'test-with-collision',
})

const greeting = signal('Hello')

// ERROR: Función con el MISMO nombre que el signal - debería fallar en compilación
function greeting() {
  return 'Hi'
}
</script>

<template>
  <div class="test-container">
    <h3>❌ Test 2: Name Collision Detection</h3>
    
    <div class="test-case">
      <h4>Test Case 2: Signal vs Function with SAME Name</h4>
      
      <div class="error-info">
        <p><strong>This component SHOULD FAIL at compile time!</strong></p>
        <p>If you see this rendered, the collision detection is NOT working.</p>
      </div>

      <div class="result">
        <p><strong>Signal:</strong> {{greeting()}}</p>
        <p><strong>Function:</strong> {{greeting()}}</p>
      </div>
      
      <div class="expected">
        <h5>Expected Error Message:</h5>
        <code>
          Error en 'test-with-collision.wcc': Colisión de nombres - 'greeting' está definido como signal y function.<br>
          Solución: Usa un nombre diferente para la función (ej: getGreeting) o convierte el signal a una función.
        </code>
      </div>
    </div>
  </div>
</template>

