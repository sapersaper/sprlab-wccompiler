<script>
import { defineComponent, defineProps, defineEmits } from 'wcc'

export default defineComponent({
  tag: 'user-panel',
})

const props = defineProps({
  title: 'User Panel',
  count: 0
})

const emit = defineEmits(['custom-event'])

function emitEvent() {
  emit('custom-event', { action: 'user-action', timestamp: Date.now() })
}
</script>

<template>
  <div class="user-panel">
    <h4>👤 User Panel</h4>
    <p><strong>Title:</strong> {{props.title}}</p>
    <p><strong>Count:</strong> {{props.count}}</p>
    <button @click="emitEvent">Emit Custom Event</button>
  </div>
</template>

<style>
.user-panel {
  padding: 15px;
  background-color: #e3f2fd;
  border-left: 4px solid #2196f3;
  border-radius: 4px;
}

.user-panel button {
  margin-top: 10px;
  padding: 8px 16px;
  background-color: #2196f3;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
</style>
