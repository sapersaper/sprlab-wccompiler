<script>
import { defineComponent, defineProps, defineEmits } from 'wcc'

export default defineComponent({
  tag: 'admin-panel',
})

const props = defineProps({
  title: 'Admin Panel',
  count: 0
})

const emit = defineEmits(['custom-event'])

function emitEvent() {
  emit('custom-event', { action: 'admin-action', timestamp: Date.now() })
}
</script>

<template>
  <div class="admin-panel">
    <h4>👑 Admin Panel</h4>
    <p><strong>Title:</strong> {{props.title}}</p>
    <p><strong>Count:</strong> {{props.count}}</p>
    <button @click="emitEvent">Emit Custom Event</button>
  </div>
</template>

<style>
.admin-panel {
  padding: 15px;
  background-color: #ffebee;
  border-left: 4px solid #f44336;
  border-radius: 4px;
}

.admin-panel button {
  margin-top: 10px;
  padding: 8px 16px;
  background-color: #f44336;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
</style>
