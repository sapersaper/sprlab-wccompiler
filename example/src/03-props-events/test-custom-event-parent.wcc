<script>
import { defineComponent, signal } from 'wcc'

export default defineComponent({
  tag: 'test-custom-event-parent',
})

// Signals para trackear eventos recibidos
const parentCount = signal(0)
const eventLog = signal([])
const lastMessage = signal('')

// Event handlers
function handleIncrement(event) {
  parentCount.set(event.detail.value)
  eventLog.set([...eventLog(), `Increment: ${event.detail.value}`])
}

function handleDecrement(event) {
  parentCount.set(event.detail.value)
  eventLog.set([...eventLog(), `Decrement: ${event.detail.value}`])
}

function handleReset(event) {
  parentCount.set(event.detail.value)
  eventLog.set([...eventLog(), `Reset: ${event.detail.value}`])
}

function handleMessage(event) {
  lastMessage.set(event.detail.text)
  eventLog.set([...eventLog(), `Message: "${event.detail.text}"`])
}
</script>

<template>
  <div class="parent-component">
    <h3>Test de Custom Events</h3>
    
    <div class="parent-info">
      <p><strong>Parent Count:</strong> {{parentCount()}}</p>
      <p><strong>Last Message:</strong> {{lastMessage()}}</p>
    </div>

    <!-- Child component con listeners de eventos custom -->
    <test-custom-event-child 
      @increment="handleIncrement"
      @decrement="handleDecrement"
      @reset="handleReset"
      @message="handleMessage"
    ></test-custom-event-child>

    <div class="event-log">
      <h4>Event Log (últimos 5):</h4>
      <ul>
        <li each="log in eventLog().slice(-5).reverse()">{{log}}</li>
      </ul>
    </div>
  </div>
</template>

<style>
.parent-component {
  border: 2px solid #2196f3;
  padding: 15px;
  border-radius: 8px;
  background-color: #e3f2fd;
}
.parent-component h3 {
  color: #1565c0;
  margin-top: 0;
}
.parent-info {
  background: white;
  padding: 10px;
  border-radius: 4px;
  margin-bottom: 15px;
}
.parent-info p {
  margin: 5px 0;
  font-family: monospace;
}
.event-log {
  margin-top: 15px;
  background: white;
  padding: 10px;
  border-radius: 4px;
}
.event-log h4 {
  margin-top: 0;
  color: #1565c0;
}
.event-log ul {
  list-style: none;
  padding: 0;
}
.event-log li {
  padding: 5px;
  margin: 3px 0;
  background: #f5f5f5;
  border-left: 3px solid #2196f3;
  font-family: monospace;
  font-size: 0.9em;
}
</style>
