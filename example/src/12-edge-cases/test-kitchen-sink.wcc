<script>
import { defineComponent, signal } from 'wcc'

export default defineComponent({
  tag: 'test-kitchen-sink',
})

// State management
const items = signal([
  { id: 1, name: 'Item 1', active: true, theme: 'light', size: 'medium' },
  { id: 2, name: 'Item 2', active: false, theme: 'dark', size: 'large' },
  { id: 3, name: 'Item 3', active: true, theme: 'light', size: 'small' }
])

const nextId = signal(4)
const selectedComponent = signal('comp-a')
const parentMessage = signal('Parent message')
const childUsername = signal('')
const childAge = signal(0)
const childAgree = signal(false)
const toggleCount = signal(0)
const rapidClicks = signal(0)

// Computed
const activeCount = () => items().filter(item => item.active).length
const totalItems = () => items().length

// Methods
function addItem() {
  const themes = ['light', 'dark', 'blue']
  const sizes = ['small', 'medium', 'large']
  const newItem = {
    id: nextId(),
    name: `Item ${nextId()}`,
    active: Math.random() > 0.5,
    theme: themes[Math.floor(Math.random() * themes.length)],
    size: sizes[Math.floor(Math.random() * sizes.length)]
  }
  items.set([...items(), newItem])
  nextId.set(nextId() + 1)
}

function removeLastItem() {
  const currentItems = items()
  if (currentItems.length > 0) {
    items.set(currentItems.slice(0, -1))
  }
}

function toggleItem(id) {
  items.set(items().map(item => 
    item.id === id ? { ...item, active: !item.active } : item
  ))
  toggleCount.set(toggleCount() + 1)
}

function changeTheme(id) {
  const themes = ['light', 'dark', 'blue']
  items.set(items().map(item => {
    if (item.id === id) {
      const currentIndex = themes.indexOf(item.theme)
      const nextTheme = themes[(currentIndex + 1) % themes.length]
      return { ...item, theme: nextTheme }
    }
    return item
  }))
}

function switchComponent() {
  const components = ['comp-a', 'comp-b', 'comp-c']
  const currentIndex = components.indexOf(selectedComponent())
  const nextComponent = components[(currentIndex + 1) % components.length]
  selectedComponent.set(nextComponent)
}

function handleChildEvent(detail) {
  parentMessage.set(`Child event received: ${detail}`)
}

function handleChildModel(e) {
  const { prop, value } = e.detail
  if (prop === 'username') childUsername.set(value)
  else if (prop === 'age') childAge.set(value)
  else if (prop === 'agree') childAgree.set(value)
}

function rapidUpdate() {
  // Simulate rapid state changes
  for (let i = 0; i < 10; i++) {
    setTimeout(() => {
      toggleCount.set(toggleCount() + 1)
      rapidClicks.set(rapidClicks() + 1)
    }, i * 50)
  }
}

function updateAllThemes() {
  const themes = ['light', 'dark', 'blue']
  items.set(items().map((item, index) => ({
    ...item,
    theme: themes[index % themes.length]
  })))
}
</script>

<style>
.kitchen-sink {
  padding: 20px;
  font-family: Arial, sans-serif;
  max-width: 1200px;
  margin: 0 auto;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 20px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.stats {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
}

.stat-box {
  background: #f0f0f0;
  padding: 15px;
  border-radius: 8px;
  flex: 1;
  text-align: center;
}

.controls {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

button {
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.2s;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}

.btn-primary { background: #667eea; color: white; }
.btn-success { background: #48bb78; color: white; }
.btn-danger { background: #f56565; color: white; }
.btn-warning { background: #ed8936; color: white; }
.btn-info { background: #4299e1; color: white; }

.item-list {
  display: grid;
  gap: 15px;
  margin-bottom: 20px;
}

.item-card {
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  padding: 15px;
  transition: all 0.3s;
}

.item-card.active {
  border-color: #48bb78;
  background: #f0fff4;
}

.item-card.inactive {
  border-color: #f56565;
  background: #fff5f5;
  opacity: 0.7;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.item-actions {
  display: flex;
  gap: 8px;
}

.dynamic-section {
  border: 2px dashed #cbd5e0;
  border-radius: 8px;
  padding: 20px;
  margin-top: 20px;
}

.slot-section {
  background: #faf5ff;
  border: 2px solid #d6bcfa;
  border-radius: 8px;
  padding: 20px;
  margin-top: 20px;
}

.message-box {
  background: #ebf8ff;
  border-left: 4px solid #4299e1;
  padding: 15px;
  margin-top: 20px;
  border-radius: 4px;
}

.rapid-test {
  background: #fffaf0;
  border: 2px solid #fbd38d;
  border-radius: 8px;
  padding: 20px;
  margin-top: 20px;
}
</style>

<template>
<div class="kitchen-sink">
  <!-- Header with stats -->
  <div class="header">
    <h2>🍳 Kitchen Sink Test - Complex Feature Integration</h2>
    <p>Mixing: Loops + Dynamic Components + Slots + Class Bindings + Style Bindings + Events + v-model</p>
  </div>

  <!-- Statistics -->
  <div class="stats">
    <div class="stat-box">
      <h3>Total Items</h3>
      <p style="font-size: 2em; font-weight: bold;">{{ totalItems() }}</p>
    </div>
    <div class="stat-box">
      <h3>Active Items</h3>
      <p style="font-size: 2em; font-weight: bold; color: #48bb78;">{{ activeCount() }}</p>
    </div>
    <div class="stat-box">
      <h3>Toggle Count</h3>
      <p style="font-size: 2em; font-weight: bold; color: #667eea;">{{ toggleCount() }}</p>
    </div>
    <div class="stat-box">
      <h3>Rapid Clicks</h3>
      <p style="font-size: 2em; font-weight: bold; color: #ed8936;">{{ rapidClicks() }}</p>
    </div>
  </div>

  <!-- Control buttons -->
  <div class="controls">
    <button class="btn-success" @click="addItem()">➕ Add Item</button>
    <button class="btn-danger" @click="removeLastItem()">➖ Remove Last</button>
    <button class="btn-primary" @click="updateAllThemes()">🎨 Update All Themes</button>
    <button class="btn-info" @click="switchComponent()">🔄 Switch Component</button>
    <button class="btn-warning" @click="rapidUpdate()">⚡ Rapid Updates (10x)</button>
  </div>

  <!-- Loop with complex items -->
  <div class="item-list">
    <div each="item in items()" :key="item.id">
      <div 
        class="item-card"
        :class="{ active: item.active, inactive: !item.active, [item.theme + '-theme']: true }"
        :style="{ 
          borderColor: item.active ? '#48bb78' : '#f56565',
          borderWidth: item.size === 'large' ? '4px' : item.size === 'medium' ? '2px' : '1px'
        }"
      >
        <div class="item-header">
          <div>
            <h3>{{ item.name }}</h3>
            <p>Status: {{ item.active ? '✓ Active' : '✗ Inactive' }}</p>
            <p>Theme: {{ item.theme }} | Size: {{ item.size }}</p>
          </div>
          <div class="item-actions">
            <button class="btn-primary" @click="toggleItem(item.id)">Toggle</button>
            <button class="btn-info" @click="changeTheme(item.id)">Change Theme</button>
          </div>
        </div>

        <!-- Nested conditional inside loop -->
        <div if="item.active">
          <p style="color: #48bb78;">✅ This item is ACTIVE</p>
        </div>
        <div else>
          <p style="color: #f56565;">❌ This item is INACTIVE</p>
        </div>

        <!-- Dynamic class based on theme -->
        <div :class="`${item.theme}-background ${item.size}-padding`">
          <small>Theme class: {{ item.theme }}-background</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Dynamic component section -->
  <div class="dynamic-section">
    <h3>🔄 Dynamic Component Section</h3>
    <p>Current component: <strong>{{ selectedComponent() }}</strong></p>
    
    <!-- Dynamic component with slot content -->
    <component :is="selectedComponent()">
      <template #header>
        <h4>Slot Header Content</h4>
      </template>
      <template #body>
        <p>This is slotted body content passed to dynamic component</p>
      </template>
      <div slot="footer">
        <p>Footer via div[slot="footer"] syntax</p>
      </div>
    </component>
  </div>

  <!-- Slot demonstration -->
  <div class="slot-section">
    <h3>📦 Slot Integration Test</h3>
    
    <!-- Parent message display -->
    <div class="message-box">
      <h4>Parent Message:</h4>
      <p>{{ parentMessage() }}</p>
    </div>

    <!-- Child component with defineModel and slots -->
    <test-model-child 
      @wcc:model="(e) => handleChildModel(e)"
      @custom-event="(e) => handleChildEvent(e.detail)"
    >
      <template #custom-slot>
        <p>Custom slot content from parent</p>
      </template>
    </test-model-child>

    <div style="margin-top: 15px;">
      <p><strong>Child Username:</strong> {{ childUsername() }}</p>
      <p><strong>Child Age:</strong> {{ childAge() }}</p>
      <p><strong>Child Agreed:</strong> {{ childAgree() }}</p>
    </div>
  </div>

  <!-- Rapid update stress test -->
  <div class="rapid-test">
    <h3>⚡ Rapid Update Stress Test</h3>
    <p>Click the button below to trigger 10 rapid state updates (50ms apart)</p>
    <p>This tests reactivity under high-frequency updates</p>
    <button class="btn-warning" @click="rapidUpdate()" style="margin-top: 10px;">
      Trigger Rapid Updates
    </button>
    <p style="margin-top: 10px;">
      <strong>Last Update Count:</strong> {{ toggleCount() }}
    </p>
  </div>

  <!-- Complex conditional with multiple conditions -->
  <div if="items().length > 0">
    <div if="activeCount() === items().length">
      <div style="background: #c6f6d5; padding: 15px; border-radius: 8px; margin-top: 20px;">
        <h4>🎉 All Items Active!</h4>
        <p>All {{ items().length }} items are currently active</p>
      </div>
    </div>
    <div else-if="activeCount() === 0">
      <div style="background: #fed7d7; padding: 15px; border-radius: 8px; margin-top: 20px;">
        <h4>⚠️ No Active Items</h4>
        <p>All items are currently inactive</p>
      </div>
    </div>
    <div else>
      <div style="background: #fefcbf; padding: 15px; border-radius: 8px; margin-top: 20px;">
        <h4>ℹ️ Mixed State</h4>
        <p>{{ activeCount() }} of {{ items().length }} items are active</p>
      </div>
    </div>
  </div>
</div>
</template>
